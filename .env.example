OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=sqlite:///./psych_support_bot.db
ENVIRONMENT=development
APP_DEBUG=false

# Identity: configure a persistent random secret before deployment.
AUTH_ENABLED=true
JWT_SECRET_KEY=
# Speech: separate provider keys; blank keys disable provider calls.
VOICE_STT_PROVIDER=openai
VOICE_STT_API_KEY=
VOICE_TTS_PROVIDER=openai
VOICE_TTS_API_KEY=
# Psy profile / context settings use application defaults.
# No Mirror service, shared credentials or shared database is configured.
