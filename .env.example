# ── LLM ──────────────────────────────────────────────
# 小红书 dots3-note-prev 模型（OpenAI 兼容接口）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://note3-prev-api.askdiandian.com/v1
OPENAI_MODEL=dots3-note-prev

# ── 数据库 ────────────────────────────────────────────
# 本地开发默认 SQLite，生产环境用 PostgreSQL
DATABASE_URL=sqlite:///./data/psych_support_bot.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/psych_support_bot

# ── Redis（可选，当前未集成）─────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Langfuse 可观测性 ─────────────────────────────────
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://us.cloud.langfuse.com
# 流量环境标记：生产保持 production；evals 自动置 eval、pytest 置 test。
# 手动联调脚本建议设 LANGFUSE_ENVIRONMENT=test，避免污染生产 trace。
LANGFUSE_ENVIRONMENT=production

# ── 语音 I/O（独立供应商配置，与主 LLM 分离，便于换模型）──────
# STT 语音转写（转写速度直接决定对话响应快慢，推荐 minimax asr-1.0 ~1s；
# dots 走思考型 LLM 转写准确但慢 ~4-6s，免费可作为省钱选项）：
#   VOICE_STT_PROVIDER=minimax → MiniMax 语音转文字（multipart /speech_to_text，
#   Bearer 鉴权；base_url 缺省 https://api.minimax.cn/v1，model 缺省 asr-1.0）
#   VOICE_STT_PROVIDER=openai → OpenAI 兼容 multipart /audio/transcriptions
#   VOICE_STT_PROVIDER=dots   → dots chat completions + audio_url 内容块
#   （音频以 base64 data URI 内联请求体，无需公网可达的托管 URL）
# VOICE_STT_PROVIDER=minimax
# VOICE_STT_API_KEY=your_minimax_key
# VOICE_STT_MODEL=asr-1.0
# VOICE_STT_LANGUAGE=zh
# VOICE_STT_PROVIDER=openai
# VOICE_STT_BASE_URL=https://api.openai.com/v1
# VOICE_STT_API_KEY=your_stt_key
# VOICE_STT_MODEL=whisper-1
# VOICE_STT_LANGUAGE=zh
# VOICE_STT_PROVIDER=dots
# VOICE_STT_BASE_URL=https://note3-prev-api.askdiandian.com/v1
# VOICE_STT_API_KEY=your_dots_key
# VOICE_STT_MODEL=dots3-note-prev
#   VOICE_STT_PROVIDER=mimo → 小米 MiMo ASR（OpenAI 兼容 chat completions +
#   input_audio base64；base_url 缺省 https://api.xiaomimimo.com/v1，
#   model 缺省 mimo-v2.5-asr；支持方言/自动标点）
# VOICE_STT_PROVIDER=mimo
# VOICE_STT_API_KEY=your_mimo_key
# STT 上下文词表（提升领域专名识别：openai 走 whisper prompt 字段、dots 拼进
# 转写指令；minimax /speech_to_text 无此参数不发送）。缺省用内置心理陪伴词表
# （按语种自动选中/英文版）；显式配置即覆盖；置 off 禁用。
# VOICE_STT_PROMPT=正念 着陆练习 心悸
# TTS 语音合成（未配置时前端降级浏览器朗读）：
#   VOICE_TTS_PROVIDER=minimax → MiniMax 双向流式 TTS（wss t2a_v2_bidi，
#   服务端攒句合成 mp3；需 VOICE_TTS_API_KEY，voice/model 可选）
#   VOICE_TTS_PROVIDER=mimo → 小米 MiMo TTS（OpenAI 兼容 chat completions，
#   wav/pcm16 24kHz；base_url 缺省 https://api.xiaomimimo.com/v1，
#   model 缺省 mimo-v2.5-tts，voice 缺省 冰糖；支持音色复刻）
#   VOICE_TTS_PROVIDER=openai  → OpenAI 兼容 POST /audio/speech
# VOICE_TTS_PROVIDER=minimax
# VOICE_TTS_API_KEY=your_minimax_key
# VOICE_TTS_MODEL=speech-2.8-turbo（更快；hd 音质更细）
# VOICE_TTS_VOICE=Chinese (Mandarin)_Warm_Bestie
# VOICE_TTS_LANGUAGE_BOOST=Chinese
# VOICE_TTS_WS_URL=wss://api.minimax.cn/ws/v1/t2a_v2_bidi
# VOICE_TTS_PROVIDER=openai
# VOICE_TTS_BASE_URL=https://api.openai.com/v1
# VOICE_TTS_API_KEY=your_tts_key
# VOICE_TTS_MODEL=tts-1
# VOICE_TTS_VOICE=alloy

# ── 应用配置 ──────────────────────────────────────────
ENVIRONMENT=development
APP_DEBUG=true
DEFAULT_CONVERSATION_MODE=support
